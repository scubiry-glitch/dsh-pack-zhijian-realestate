{
  "id": "zhijian.team.rent-pricing",
  "version": "1.2.1",
  "schemaVersion": 2,
  "parameters": {
    "type": "object",
    "properties": {
      "property": {
        "type": "string",
        "description": "标的地址、面积、户型、出租方式和用户给定条件；未核实的条件明确标未核"
      },
      "asOfDate": {
        "type": "string",
        "description": "价格与样本基准日，YYYY-MM-DD"
      }
    },
    "required": [
      "property",
      "asOfDate"
    ]
  },
  "slots": [
    {
      "id": "role.evidence",
      "capabilities": [
        "realestate.services.review",
        "review.data"
      ],
      "cardinality": {
        "min": 1,
        "max": 1
      }
    },
    {
      "id": "role.pricing",
      "capabilities": [
        "realestate.services.review",
        "review.judgment"
      ],
      "cardinality": {
        "min": 1,
        "max": 1
      }
    },
    {
      "id": "role.render",
      "capabilities": [
        "realestate.services.review",
        "review.theory"
      ],
      "cardinality": {
        "min": 1,
        "max": 1
      }
    }
  ],
  "tasks": [
    {
      "id": "t1",
      "role": "role.evidence",
      "dependsOn": [],
      "inputs": [
        {
          "kind": "parameter",
          "ref": "property"
        },
        {
          "kind": "parameter",
          "ref": "asOfDate"
        }
      ],
      "allowedCapabilities": [
        "realestate.resblock.profile",
        "realestate.rent.search",
        "realestate.plate.search",
        "realestate.indicators.timeseries",
        "realestate.market-snapshot"
      ],
      "outputSchema": "zhijian.output.rent-evidence",
      "retryPolicy": "provider-only",
      "subject": "核验标的与采集同质可比证据",
      "description": "一次形成共同证据包：核标的产品、出租形态及未核字段；采集同小区/邻近同质挂牌或成交，保存逐次原始回执、查询、时间、TopK、总召回、实际命中条件、去重与缺口。总召回超过 TopK 时，用实际命中的价格分段覆盖全域，必要时细分，按房源 ID 去重并与总召回核对；查询文字中的业务类型或面积未命中时逐行筛选并记录剔除。无法取齐只报可见样本及截断风险。尽量取得同小区近 12 个月逐月租金及统计口径；它只作背景，不替代同质可比。接口不可用如实记录并停止确定性失败重试。发布 t1-evidence.md、结构化样本表和趋势序列或缺口。独立评审核来源、身份和样本口径，阻断项在本任务返修。"
    },
    {
      "id": "t2",
      "role": "role.pricing",
      "dependsOn": [
        "t1"
      ],
      "inputs": [
        {
          "kind": "task-output",
          "ref": "t1"
        }
      ],
      "allowedCapabilities": [],
      "outputSchema": "zhijian.output.rent-data",
      "retryPolicy": "quality-repair",
      "subject": "测算定价并填写模板数据",
      "description": "使用 t1 的固定证据包写 rent-pricing-data.json：标的条件、三档决策量（无证据则 null/待确认）、可比明细、三种固定参考依据、逐步计算明细、社区近 12 个月租金序列或缺口、行动、风险和来源。每种方法填写状态、发现、算式和证据；有数值时逐步写输入、公式、结果、证据。社区跨户型趋势只作背景，绝不沿用海兴雅苑价格或序列。依据 references/rent-pricing-data-v2.md；独立评审逐条复算承重价格、样本 n、来源和条件，阻断问题由本任务作者修复后重审。发布 t2-pricing-data.json 和计算回执。"
    },
    {
      "id": "t3",
      "role": "role.render",
      "dependsOn": [
        "t2"
      ],
      "inputs": [
        {
          "kind": "task-output",
          "ref": "t2"
        }
      ],
      "allowedCapabilities": [],
      "outputSchema": "zhijian.output.rent-pricing",
      "retryPolicy": "quality-repair",
      "subject": "固定模板生成并核对 HTML/PDF",
      "description": "从已审 t2-pricing-data.json 运行 scripts/render-rent-pricing.py，生成同源 Markdown、HTML、craft-evidence.json 和可选文字的 PDF。必须使用 rent-pricing-shell-v2，不得改走通用 Markdown 转 HTML。核对单个 H1、三档卡、可比明细、逐步计算、真实社区 12 个月图或缺口、来源、手机和 A4；按数据哈希核对 MD/HTML/PDF。渲染中的事实变更回到 t2 重审，不为格式问题另开新节点。"
    }
  ],
  "gates": [],
  "deliverables": [
    {
      "id": "rent-pricing-report",
      "outputTemplate": "zhijian.output.rent-pricing",
      "fromTasks": [
        "t3"
      ],
      "renderMode": "final"
    }
  ]
}
