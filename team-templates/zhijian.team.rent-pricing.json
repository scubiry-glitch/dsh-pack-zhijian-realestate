{
  "id": "zhijian.team.rent-pricing",
  "version": "1.1.0",
  "schemaVersion": 2,
  "parameters": {
    "type": "object",
    "properties": {
      "property": {
        "type": "string",
        "description": "标的地址、面积、户型、出租方式和用户给定条件；未核实的条件明确标未核"
      },
      "asOfDate": {
        "type": "string",
        "description": "价格与样本基准日，YYYY-MM-DD"
      }
    },
    "required": [
      "property",
      "asOfDate"
    ]
  },
  "slots": [
    {
      "id": "role.evidence",
      "capabilities": [
        "realestate.services.review",
        "review.data"
      ],
      "cardinality": {
        "min": 1,
        "max": 1
      }
    },
    {
      "id": "role.pricing",
      "capabilities": [
        "realestate.services.review",
        "review.judgment"
      ],
      "cardinality": {
        "min": 1,
        "max": 1
      }
    },
    {
      "id": "role.render",
      "capabilities": [
        "realestate.services.review",
        "review.theory"
      ],
      "cardinality": {
        "min": 1,
        "max": 1
      }
    }
  ],
  "tasks": [
    {
      "id": "t1",
      "role": "role.evidence",
      "dependsOn": [],
      "inputs": [
        {
          "kind": "parameter",
          "ref": "property"
        },
        {
          "kind": "parameter",
          "ref": "asOfDate"
        }
      ],
      "allowedCapabilities": [
        "realestate.resblock.profile",
        "realestate.rent.search",
        "realestate.plate.search",
        "realestate.indicators.timeseries",
        "realestate.market-snapshot"
      ],
      "outputSchema": "zhijian.output.rent-evidence",
      "retryPolicy": "provider-only",
      "subject": "核验标的与采集同质可比证据",
      "description": "一次形成共同证据包：核标的产品、出租形态及未核字段；采集同小区/邻近同质挂牌或成交，保存逐次原始回执、查询、时间、TopK、去重与缺口。可用趋势或替代品只作为补充边界。接口不可用如实记录并停止确定性失败重试。发布 t1-evidence.md 与结构化样本表。独立评审只核来源、身份和样本口径，阻断项在本任务返修。"
    },
    {
      "id": "t2",
      "role": "role.pricing",
      "dependsOn": [
        "t1"
      ],
      "inputs": [
        {
          "kind": "task-output",
          "ref": "t1"
        }
      ],
      "allowedCapabilities": [],
      "outputSchema": "zhijian.output.rent-data",
      "retryPolicy": "quality-repair",
      "subject": "测算定价并填写模板数据",
      "description": "使用 t1 的固定证据包写 rent-pricing-data.json：标的条件、三档决策量（无证据则 null/待确认）、同质样本、主估计、交叉边界、空置行动、风险和来源。依据 references/rent-pricing-data-v2.md 与报告模板；不得沿用海兴雅苑价格。稿件简明，结论先行；独立评审逐条复算承重价格、样本 n、来源和条件，阻断问题由本任务作者修复后重审。发布 t2-pricing-data.json 和计算回执。"
    },
    {
      "id": "t3",
      "role": "role.render",
      "dependsOn": [
        "t2"
      ],
      "inputs": [
        {
          "kind": "task-output",
          "ref": "t2"
        }
      ],
      "allowedCapabilities": [],
      "outputSchema": "zhijian.output.rent-pricing",
      "retryPolicy": "quality-repair",
      "subject": "固定模板生成并核对 HTML/PDF",
      "description": "从已审 t2-pricing-data.json 运行 scripts/render-rent-pricing.py，生成同源 Markdown、HTML、craft-evidence.json；并生成可选文字的 PDF。必须使用 rent-pricing-shell-v2，不得改走通用 Markdown 转 HTML。核对单个 H1、三档卡、真实样本图或数据缺口、来源、手机和 A4；按数据哈希核对 MD/HTML/PDF 版本。渲染中的事实变更回到 t2 重审，不为格式问题另开新节点。"
    }
  ],
  "gates": [],
  "deliverables": [
    {
      "id": "rent-pricing-report",
      "outputTemplate": "zhijian.output.rent-pricing",
      "fromTasks": [
        "t3"
      ],
      "renderMode": "final"
    }
  ]
}
