{
  "id": "zhijian.team.rent-pricing",
  "version": "1.0.0",
  "schemaVersion": 2,
  "parameters": {
    "type": "object",
    "properties": {
      "property": { "type": "string", "description": "标的地址、面积、户型、出租方式和用户给定条件；未核实的条件明确标未核" },
      "asOfDate": { "type": "string", "description": "价格与样本基准日，YYYY-MM-DD" }
    },
    "required": ["property", "asOfDate"]
  },
  "slots": [
    { "id": "role.research", "capabilities": ["realestate.services.review"], "cardinality": { "min": 1, "max": 3 } },
    { "id": "role.pricing", "capabilities": ["zhijian.review"], "cardinality": { "min": 1, "max": 1 } },
    { "id": "role.audit", "capabilities": ["zhijian.review"], "cardinality": { "min": 1, "max": 1 } },
    { "id": "role.render", "capabilities": [], "cardinality": { "min": 0, "max": 1 } }
  ],
  "tasks": [
    {
      "id": "t1", "role": "role.research", "dependsOn": [],
      "inputs": [{ "kind": "parameter", "ref": "property" }, { "kind": "parameter", "ref": "asOfDate" }],
      "allowedCapabilities": ["realestate.resblock.profile", "realestate.rent.search"],
      "outputSchema": "zhijian.output.B", "retryPolicy": "provider-only",
      "subject": "核验标的形态、出租权利与数据可得性",
      "description": "核实 {property} 的独立入户、厨卫、水电计量、建筑/套内面积、装修、楼层、朝向、家具、租期与出租权利；未取到的条件列为待确认。基准日 {asOfDate}。记录每个数据接口的能力、时间和缺口。若整租/合租属性未明，不把两类样本混算。输出带来源的标的条件表和待补问题。"
    },
    {
      "id": "t2", "role": "role.research", "dependsOn": ["t1"],
      "inputs": [{ "kind": "task-output", "ref": "t1" }],
      "allowedCapabilities": ["realestate.rent.search", "realestate.resblock.profile", "realestate.plate.search"],
      "outputSchema": "zhijian.output.B", "retryPolicy": "provider-only",
      "subject": "采集与标的同质的在租和成交证据",
      "description": "用 t1 已核的产品形态筛本小区、邻近板块和区级同质样本。逐次保留查询式、基准日、返回上限/TopK、原始行数、去重键、剔除理由、有效 n、价格单位及挂牌/成交身份；不把多次 TopK 拼成市场全量。成交数据不可得就明确缺口。产出可复算的样本表。"
    },
    {
      "id": "t3", "role": "role.research", "dependsOn": ["t1"],
      "inputs": [{ "kind": "task-output", "ref": "t1" }],
      "allowedCapabilities": ["realestate.rent.search", "realestate.indicators.timeseries", "realestate.market-snapshot"],
      "outputSchema": "zhijian.output.B", "retryPolicy": "provider-only",
      "subject": "独立寻找交叉证据、替代品边界和时点信号",
      "description": "单独核验单位面积租金、可替代产品及可用趋势。替代品只界定价格边界，不无条件折算为同质估价；社区混合户型趋势只判时点，不代替目标户型租金。每条证据标来源、周期、区域、单位、产品类型和限制。没有足够独立证据就明说，不凑三路。"
    },
    {
      "id": "t4", "role": "role.pricing", "dependsOn": ["t1", "t2", "t3"],
      "inputs": [{ "kind": "task-output", "ref": "t1" }, { "kind": "task-output", "ref": "t2" }, { "kind": "task-output", "ref": "t3" }],
      "allowedCapabilities": [], "outputSchema": "zhijian.output.rent-pricing", "retryPolicy": "quality-repair",
      "subject": "定价测算与行动方案",
      "description": "依照本包 zhijian-rent-pricing skill 和 rent-pricing-report-template-v1.md，用本次样本计算分位数、单位面积交叉值、挂牌区间/目标成交带/底价及让价节奏。三者必须各有推导与适用条件；挂牌价不是成交事实，底价是用户成本/空置偏好约束。证据冲突时说明原因并降精度，不机械取交集。仅在产品形态确有互斥可能时写 A/B 案。图稿先写清观点、关系、数据源和限制。"
    },
    {
      "id": "t5", "role": "role.audit", "dependsOn": ["t4"],
      "inputs": [{ "kind": "task-output", "ref": "t4" }, { "kind": "task-output", "ref": "t2" }, { "kind": "task-output", "ref": "t3" }],
      "allowedCapabilities": [], "outputSchema": "zhijian.output.B", "retryPolicy": "never",
      "subject": "独立复算与反证",
      "description": "由不同于 t4 作者的成员独立复核每条承重价格、样本 n 与去重、分位数、元/㎡、空置损益、来源与基准日；检查整租/合租混样、挂牌冒充成交、社区趋势冒充目标房型及无证据的底价。输出具体问题和可操作修正，不代作者自签通过。"
    },
    {
      "id": "t6", "role": "role.render", "dependsOn": ["t5"],
      "inputs": [{ "kind": "task-output", "ref": "t4" }, { "kind": "task-output", "ref": "t5" }],
      "allowedCapabilities": [], "outputSchema": "zhijian.output.rent-pricing", "retryPolicy": "quality-repair",
      "subject": "根据已审定价稿制作并检查报告",
      "description": "先检查 t5 的独立审计：有阻断项时退回 t4 修订并重审，不直接渲染。通过后按本包租金定价模板与页面骨架制作 HTML/PDF。每张图陈述可核的定价逻辑，图内区分观测挂牌、成交、推算与建议价；没有有效趋势就不画趋势图。保持正文、图表、价格档位和来源一致；检查宽屏、手机与 A4 实际输出，记录视觉缺陷并修复。"
    }
  ],
  "gates": [
    { "policy": "zhijian.quality", "gate": "data-citation", "appliesTo": ["t6"] }
  ],
  "deliverables": [
    { "id": "rent-pricing-report", "outputTemplate": "zhijian.output.rent-pricing", "fromTasks": ["t6"], "renderMode": "final" }
  ]
}
