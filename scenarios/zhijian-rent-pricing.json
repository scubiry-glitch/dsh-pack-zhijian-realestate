{
  "id": "zhijian-rent-pricing",
  "version": "1.2.0",
  "schemaVersion": 2,
  "domain": "realestate",
  "intents": [
    "rent-pricing",
    "rental-listing-advice"
  ],
  "requiredCapabilities": [
    {
      "capability": "zhijian.review",
      "minProficiency": 1,
      "cardinality": 1
    },
    {
      "capability": "realestate.services.review",
      "minProficiency": 1,
      "cardinality": 1
    }
  ],
  "routingPolicy": {
    "assertions": [
      "面向具体住宅或公寓的月租定价；先辨明出租形态与标的条件，不以小区资料推断单套权利。",
      "采用三段任务：一次取证、一次测算及正文、一次模板渲染；每段沿用 Host 独立评审，作者在原任务内修复阻断项，不另开审计与复审任务。",
      "图文由同一份本次数据通过 rent-pricing-shell-v3 生成；有样本才绘制样本图，没有可比数据则呈现缺口，不复制历史价格。",
      "挂牌、成交、推断与建议价显式分开；底价缺少业主成本和偏好时标为待确认。"
    ],
    "candidateHints": [
      "bk-033",
      "bk-018",
      "bk-002",
      "bk-020"
    ]
  },
  "teamTemplate": "zhijian.team.rent-pricing",
  "outputTemplate": "zhijian.output.rent-pricing",
  "qualityPolicy": "zhijian.quality.rent-pricing",
  "knowledgePolicy": {
    "required": [
      "zhijian-expert-memory"
    ],
    "optional": [
      "local-knowledge"
    ]
  },
  "toolPolicy": {
    "allowed": []
  }
}
